# Setup-time DSN — full privileges. Used by `agent-mv apply` and `setup-mcp`.
DATABASE_URL=postgresql://demo:demo@localhost:55432/shop

# Runtime DSN — view-only role created by `agent-mv apply`.
# The password embedded here MUST match AGENT_MV_RUNTIME_PASSWORD below;
# `agent-mv apply` sets the role's password from AGENT_MV_RUNTIME_PASSWORD on
# first install, and the runtime MCP / `psql` connect using AGENT_MV_RUNTIME_URL.
AGENT_MV_RUNTIME_URL=postgresql://agent_mv_runtime:agent_mv_runtime@localhost:55432/shop
AGENT_MV_RUNTIME_PASSWORD=agent_mv_runtime
